{
  "name": "@wethegit/gordito-carousel",
  "version": "1.1.0",
  "description": "A robust carousel with support for infinite slides and touch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wethegit/gordito-carousel.git"
  },
  "style": "./dist/wtc-gordito-carousel.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./react/style.css": "./dist/react/style.css",
    "./wtc-gordito-carousel.css": "./dist/wtc-gordito-carousel.css",
    "./package.json": "./package.json",
    "./style.css": "./dist/wtc-gordito-carousel.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-css.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepare": "husky",
    "dev": "npm run site:dev",
    "site:dev": "vite --config site/vite.config.js",
    "site:build": "vite build --config site/vite.config.js"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=24"
  },
  "css": "./dist/wtc-gordito-carousel.css"
}
